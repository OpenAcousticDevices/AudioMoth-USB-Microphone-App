{
  "name": "AudioMoth-Mic",
  "version": "1.2.6",
  "description": "The configuration app for the AudioMoth USB microphone.",
  "main": "main.js",
  "author": "openacousticdevices.info <theteam@openacousticdevices.info>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAcousticDevices/AudioMoth-USB-Microphone-App.git"
  },
  "scripts": {
    "postinstall": "install-app-deps && node scripts/install-electron-binary.js",
    "start": "electron .",
    "dist": "node builder.js",
    "install-electron-binary": "node scripts/install-electron-binary.js"
  },
  "build": {
    "asar": {
      "smartUnpack": true
    },
    "appId": "info.openacousticdevices.audiomothusbmicrophoneapp",
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.inherit.plist",
      "target": {
        "target": "dmg",
        "arch": "universal"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 430,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "AudioMothUSBMicrophoneAppSetup${version}.dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AudioMothUSBMicrophoneAppSetup${version}.exe",
      "shortcutName": "AudioMoth USB Microphone App",
      "uninstallDisplayName": "AudioMoth USB Microphone App ${version}"
    },
    "linux": {
      "icon": "build/",
      "category": "Utility",
      "artifactName": "AudioMothUSBMicrophoneAppSetup${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@popperjs/core": "^2.11.8",
    "audiomoth-hid": "^2.3.0",
    "audiomoth-utils": "^1.10.0",
    "bootstrap": "^5.3.8",
    "bootstrap-slider": "^11.0.2",
    "electron-debug": "4.1.0",
    "electron-localshortcut": "^3.2.1",
    "jquery": "^4.0.0",
    "jsonschema": "1.5.0",
    "popper.js": "^1.15.0",
    "showdown": "^2.1.0",
    "strftime": "0.10.3"
  },
  "engines": {
    "node": ">=26.1.0"
  }
}
